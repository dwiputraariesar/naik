# Template Environment Variables untuk Project NAIK (Summittact)
# Salin file ini menjadi .env.local dan isi dengan nilai asli dari dashboard Supabase.
# PENTING: JANGAN commit file .env.local yang berisi credential asli ke Git!

# URL project Supabase Anda (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Publishable key (anon key) Supabase yang aman digunakan di client-side (Settings -> API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
